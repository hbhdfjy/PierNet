# PierNet portable runtime configuration.
# Copy this file to .env on each server and edit only local paths/secrets there.

# Config loading
PierNet_ENV_FILE=/path/to/PierNet/.env

# Repository and runtime roots
PierNet_ROOT=/path/to/PierNet
PierNet_DATA_ROOT=/path/to/PierNet/data
PierNet_ARTIFACT_ROOT=/path/to/PierNet/artifacts
PierNet_RUNLOG_ROOT=/path/to/PierNet/.runlogs

# SQLite runtime stores
PierNet_JOB_STORE_PATH=/path/to/PierNet/.runlogs/jobs.sqlite
PierNet_TRAINING_JOB_STORE_PATH=/path/to/PierNet/.runlogs/training_jobs.sqlite
PierNet_LOCK_STORE_PATH=/path/to/PierNet/.runlogs/job_locks.sqlite
PierNet_AUDIT_STORE_PATH=/path/to/PierNet/.runlogs/audit_events.sqlite
PierNet_WORKER_STORE_PATH=/path/to/PierNet/.runlogs/worker_heartbeats.sqlite
PierNet_ROUTER_JSONL_CACHE_DIR=/path/to/PierNet/data/router/.parquet_jsonl_cache

# HTTP services
PierNet_HOST=0.0.0.0
PierNet_BACKEND_PORT=8000
PierNet_FRONTEND_PORT=3000
PierNet_E2E_PORT=5174
PierNet_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
PierNet_FRONTEND_ALLOWED_HOSTS=

# Worker queue
PierNet_WORKER_QUEUE_SYNTH=1
PierNet_WORKER_QUEUE_TRAINING=1
PierNet_WORKER_QUEUE_LOCK_TTL_SECONDS=60
PierNet_WORKER_STALE_AFTER_SECONDS=90
PierNet_LOCK_TTL_SECONDS=86400
PierNet_SYNTH_LOCK_TTL_SECONDS=86400
PierNet_GPU_LOCK_TTL_SECONDS=604800
PierNet_TRAINING_QUEUE_DEFAULT_PRIORITY=100

# Service supervisor settings
PierNet_SERVICE_RUN_DIR=/path/to/PierNet/.runlogs/services
PierNet_SERVICE_USER=your-linux-user
PierNet_SERVICE_WORKER=auto
PierNet_SYSTEMD_USER_DIR=/home/your-linux-user/.config/systemd/user
PierNet_INSTALL_WORKER=1
PierNet_STATUS_TAIL_LINES=20

# Python and Node runtime
PierNet_CONDA_BASE=/path/to/miniconda
PierNet_CONDA_ENV=/path/to/miniconda/envs/PierNet
PierNet_PYTHON=/path/to/miniconda/envs/PierNet/bin/python
PierNet_TRAINING_PYTHON=/path/to/miniconda/envs/PierNet/bin/python
PierNet_NPM=npm
PierNet_NODE_BIN=/path/to/miniconda/envs/PierNet/bin/node
PierNet_NODE_VERSION=20

# Model and simulator paths
PierNet_QWEN_EMBEDDING_MODEL=/path/to/Qwen/Qwen2.5-0.5B-Instruct
PierNet_QWEN_EMBEDDING_TOKENIZER=/path/to/Qwen/Qwen2.5-0.5B-Instruct
PierNet_MODFLOW_EXE=/path/to/mf2005

# Training and preparation defaults
PierNet_MAX_WORKERS=8
PierNet_DEFAULT_TRAIN_WORKERS=8
PierNet_DEFAULT_PREPARE_WORKERS=8
PierNet_ROUTER_BUILD_WORKERS=8
PierNet_GPU_FREE_MEMORY_THRESHOLD_MIB=2048
PierNet_GPU_AVAILABLE_UTIL_THRESHOLD=20

# Optional LLM/API credentials. Keep real values only in .env.
OPENAI_API_KEY=
DASHSCOPE_API_KEY=
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=
ANTHROPIC_CUSTOM_HEADERS=
GITHUB_TOKEN=

# Optional patent conversion template
PierNet_PATENT_TEMPLATE=/path/to/template.docx

# Logging
PierNet_LOG_LEVEL=INFO
