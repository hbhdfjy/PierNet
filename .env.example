# PiERN portable runtime configuration.
# Copy this file to .env on each server and edit only local paths/secrets there.

# Config loading
PIERN_ENV_FILE=/path/to/piern/.env

# Repository and runtime roots
PIERN_ROOT=/path/to/piern
PIERN_DATA_ROOT=/path/to/piern/data
PIERN_ARTIFACT_ROOT=/path/to/piern/artifacts
PIERN_RUNLOG_ROOT=/path/to/piern/.runlogs

# SQLite runtime stores
PIERN_JOB_STORE_PATH=/path/to/piern/.runlogs/jobs.sqlite
PIERN_TRAINING_JOB_STORE_PATH=/path/to/piern/.runlogs/training_jobs.sqlite
PIERN_LOCK_STORE_PATH=/path/to/piern/.runlogs/job_locks.sqlite
PIERN_AUDIT_STORE_PATH=/path/to/piern/.runlogs/audit_events.sqlite
PIERN_WORKER_STORE_PATH=/path/to/piern/.runlogs/worker_heartbeats.sqlite
PIERN_ROUTER_JSONL_CACHE_DIR=/path/to/piern/data/router/.parquet_jsonl_cache

# HTTP services
PIERN_HOST=0.0.0.0
PIERN_BACKEND_PORT=8000
PIERN_FRONTEND_PORT=5173
PIERN_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Worker queue
PIERN_WORKER_QUEUE_SYNTH=1
PIERN_WORKER_QUEUE_TRAINING=1
PIERN_WORKER_QUEUE_LOCK_TTL_SECONDS=60
PIERN_WORKER_STALE_AFTER_SECONDS=90

# Service supervisor settings
PIERN_SERVICE_RUN_DIR=/path/to/piern/.runlogs/services
PIERN_SERVICE_USER=your-linux-user
PIERN_STATUS_TAIL_LINES=20

# Python and Node runtime
PIERN_CONDA_ENV=/path/to/miniconda/envs/piern
PIERN_PYTHON=/path/to/miniconda/envs/piern/bin/python
PIERN_TRAINING_PYTHON=/path/to/miniconda/envs/piern/bin/python
PIERN_NPM=npm
PIERN_NODE=/path/to/miniconda/envs/piern/bin/node
PIERN_NODE_BIN=/path/to/miniconda/envs/piern/bin/node
PIERN_NODE_BIN_DIR=/path/to/miniconda/envs/piern/bin
PIERN_NODE_VERSION=20

# Model and simulator paths
PIERN_QWEN_EMBEDDING_MODEL=/path/to/Qwen/Qwen2.5-0.5B-Instruct
PIERN_QWEN_EMBEDDING_TOKENIZER=/path/to/Qwen/Qwen2.5-0.5B-Instruct
PIERN_MODFLOW_EXE=/path/to/mf2005

# Training and preparation defaults
PIERN_MAX_WORKERS=8
PIERN_DEFAULT_TRAIN_WORKERS=8
PIERN_DEFAULT_PREPARE_WORKERS=8
PIERN_GPU_FREE_MEMORY_THRESHOLD_MIB=2048
PIERN_GPU_AVAILABLE_UTIL_THRESHOLD=20

# Optional LLM/API credentials. Keep real values only in .env.
OPENAI_API_KEY=
DASHSCOPE_API_KEY=
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=
ANTHROPIC_CUSTOM_HEADERS=
GITHUB_TOKEN=

# Optional patent conversion template
PIERN_PATENT_TEMPLATE=/path/to/template.docx

# Logging
PIERN_LOG_LEVEL=INFO
