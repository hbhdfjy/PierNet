[Unit]
Description=PiERN Vite frontend
After=piern-backend.service
Wants=piern-backend.service

[Service]
Type=simple
WorkingDirectory=__ROOT__
Environment=PIERN_ENV_FILE=__ROOT__/.env
Restart=on-failure
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=30
ExecStart=__ROOT__/scripts/services/run-frontend.sh

[Install]
WantedBy=default.target
